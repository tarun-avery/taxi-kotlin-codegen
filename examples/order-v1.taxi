namespace trading.v1

annotation Message {
    id: Int
    schemaId: Int
    version: Int
}

annotation Since {
    version: Int
}

annotation Field {
    id: Int
}

type OrderId inherits Long
// Price is an integer count of ten-thousandths of a currency unit.
type Price inherits Long
type Quantity inherits Long
type ClientId inherits Long

@Message(id = 1, schemaId = 1, version = 1)
model Order {
    @Field(id = 1)
    orderId: OrderId
    @Field(id = 2)
    price: Price
    @Field(id = 3)
    quantity: Quantity
    @Since(version = 1)
    @Field(id = 4)
    clientId: ClientId?
}
